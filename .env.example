# Copier ce fichier en .env pour personnaliser la configuration locale.
# Sans .env, docker compose utilise les valeurs par défaut ci-dessous.
# Ne jamais versionner le fichier .env.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=epickem
POSTGRES_PASSWORD=epickem
POSTGRES_DB=epickem

# --- Ports exposés sur la machine -------------------------------------------
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API lancée hors Docker (pnpm dev) --------------------------------------
# Dans Docker, ces URL sont construites automatiquement (hôtes postgres et redis).
DATABASE_URL=postgresql://epickem:epickem@localhost:5432/epickem
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# Cookie de session en HTTPS uniquement (accepté aussi sur http://localhost).
COOKIE_SECURE=true
# Tentatives d'inscription/connexion par minute et par adresse IP.
AUTH_RATE_LIMIT=10
