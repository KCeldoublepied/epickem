{
  "name": "@epickem/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types du domaine, schémas de validation et client API partagés",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
